{
  "name": "sugarcommerce/dates",
  "version": "1.3.0",
  "description": "UTC-first date handling: freezable clock, safe timestamp parsing, relative times, and reporting ranges with exclusive ends. Zero dependencies.",
  "type": "library",
  "license": "GPL-2.0-or-later",
  "homepage": "https://github.com/sugarcommerce/dates",
  "authors": [ { "name": "David Sherlock", "homepage": "https://arraypress.com/" } ],
  "keywords": ["date", "time", "utc", "timezone", "date-range", "relative-time", "clock", "reporting"],
  "require": { "php": ">=8.5" },
  "require-dev": { "phpunit/phpunit": "^13.0" },
  "autoload": { "psr-4": { "SugarCommerce\\Dates\\": "src/" } },
  "autoload-dev": { "psr-4": { "SugarCommerce\\Dates\\Tests\\": "tests/" } },
  "scripts": { "test": "phpunit" },
  "config": { "optimize-autoloader": true, "sort-packages": true, "preferred-install": "dist" },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "support": { "issues": "https://github.com/sugarcommerce/dates/issues", "source": "https://github.com/sugarcommerce/dates" }
}
